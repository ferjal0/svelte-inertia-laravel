        "@sveltejs/vite-plugin-svelte": "^7.3.0",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/postcss": "^4.3.3",
        "@tailwindcss/vite": "^4.3.3",
        "@tsconfig/svelte": "^5.0.8",
        "@types/node": "^22.20.2",
        "@typescript-eslint/eslint-plugin": "^8.70.0",
        "@typescript-eslint/parser": "^8.70.0",
        "bits-ui": "^2.19.2",
        "clsx": "^2.1.1",
        "concurrently": "^10.0.5",
        "eslint": "^9.39.5",
